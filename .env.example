# Required for live runs / evaluation
OPENAI_API_KEY=
# Optional overrides
# gpt-6.1-terra is half the price of gpt-6.2-sol, with the same accuracy on the pilot
MAIN_MODEL=gpt-6.1-terra
WORKER_MODEL=gpt-6-luna
# json_schema (default) or function_calling
STRUCTURED_METHOD=json_schema
# OPENAI_BASE_URL=

# --- Resilience: fallback chain (tried in order when a call fails or returns unparseable output)
# Other OpenAI models to try after the primary model:
FALLBACK_MODELS=gpt-6-luna,gpt-6.1-terra
# Optional second OpenAI-compatible provider (e.g. Azure OpenAI, OpenRouter, a gateway):
# FALLBACK_BASE_URL=https://your-backup-endpoint/v1
# FALLBACK_API_KEY=
# FALLBACK_PROVIDER_MODELS=gpt-6.2-sol

# --- Cost: OpenAI prompt caching (stable prompt prefixes + per-role prompt_cache_key). 1 = on
PROMPT_CACHE=1

# --- Budgets
# MAX_TOOL_CALLS=40
MAX_ROUNDS=2

# --- Observability: Langfuse (optional; tracing is on when both keys are set)
# Keys: Langfuse project → Settings → API Keys. Region: https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Persistent sessions + human-in-the-loop (LangGraph Postgres checkpointer)
# Start Postgres with: docker compose up -d   (unset = in-memory sessions, lost on restart)
DATABASE_URL=postgresql://rootcause:rootcause@localhost:5433/rootcause
# HITL_MODE=off   # CLI default; the UI lets you choose: off | stuck | review
